# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : seul .env.example est suivi
.env
.env.*
.env*
!.env.example

# sauvegardes et journaux locaux
*.bak
*.log

# outillage d'agents (skill Neon, configuration MCP) : hors de la version validée
.agents/
skills-lock.json
.cursor/
.mcp.json
mcp.json

# vercel
.vercel

# Service worker généré par Serwist au build (à retirer de l'index : git rm --cached public/sw.js)
public/sw.js
public/workbox-*.js
public/sw.js.map

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local

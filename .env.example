# URL de l'API FastAPI. Recopiée dans le bundle Next au démarrage.
# Vide ou /api : le navigateur appelle le site, Next relaie vers l'API.
# Une URL absolue (http://127.0.0.1:8000) remet le cookie sur un autre site.
NEXT_PUBLIC_API_URL=/api

# Cible du rewrite Next /api → API. En local : 127.0.0.1:8000.
# Sur Vercel : URL publique HTTPS de l'API (Render, Railway, Fly, etc.).
API_PROXY_TARGET=http://127.0.0.1:8000
